BLOB_ACCESS=

# Vercel only: HTTPS URL for a Chromium 133 remote pack compatible with
# @sparticuz/chromium-min@133.0.0
CHROMIUM_REMOTE_EXEC_PATH=

STORAGE_ROOT="./storage"
