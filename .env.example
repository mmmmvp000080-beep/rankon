# Neon PostgreSQL (pooled connection for app runtime)
DATABASE_URL=

# Neon PostgreSQL (direct connection for Prisma migrate)
DIRECT_URL=

ADMIN_SESSION_SECRET=

# Public app URL (production domain)
APP_URL=

# Client-visible production domain for share link display (same as APP_URL in production)
